{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Warden",
  "version": "0.4.0",
  "identifier": "dev.warden.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Warden",
        "width": 1240,
        "height": 800,
        "minWidth": 920,
        "minHeight": 600,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "shortDescription": "Unattended AI pull request reviews for Azure DevOps",
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDc2MEI2MjY3RDZBQUQyODYKUldTRzBxcldaMklMZHZtNEdKMTFmSUNKbm9KeWZQQmNCNVFPMWNaSkV4UlRWdmVkaTVYZ1FKL2sK",
      "endpoints": [
        "https://github.com/Shaun-Sheppard/Warden/releases/latest/download/latest.json"
      ]
    }
  }
}
